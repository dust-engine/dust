load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Patch applied to the @sharc repository (see MODULE.bazel).
exports_files(["sharc_lock_claim.patch"])

alias(
    name = "slang",
    actual = "@vulkan_sdk//:slang",
)

cc_library(
    name = "vma",
    srcs = ["vma_wrapper.cpp"],
    deps = [
        "@vma//:vma_headers",
        "@vulkan_sdk//:vulkan_headers",
    ],
)

# Visibility bridge for the pumicite_super_resolution crate's backend link deps.
alias(
    name = "super_resolution_backend",
    actual = "@pumicite_super_resolution//:backend",
)
