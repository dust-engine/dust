load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_import(
    name = "slang_windows",
    interface_library = "@vulkan_sdk_1.4.341.1//:sdk/Lib/slang.lib",
    shared_library = "@vulkan_sdk_1.4.341.1//:sdk/Bin/slang.dll",
    target_compatible_with = ["@platforms//os:windows"],
)

cc_import(
    name = "slang_macos",
    shared_library = "@vulkan_sdk_1.4.341.1//:sdk/lib/libslang-compiler.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

cc_import(
    name = "slang_linux",
    shared_library = "@vulkan_sdk_1.4.341.1//:sdk/lib/libslang.so",
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "slang",
    deps = select({
        "@platforms//os:windows": [":slang_windows"],
        "@platforms//os:macos": [":slang_macos"],
        "@platforms//os:linux": [":slang_linux"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "vma",
    srcs = ["vma_wrapper.cpp"],
    deps = [
        "@vma//:vma_headers",
        "@vulkan_sdk_1.4.341.1//:vulkan_headers",
    ],
)
