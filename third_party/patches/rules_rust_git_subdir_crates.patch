+    /// The checkout root of a package inside a cargo git checkout
+    /// (`{CARGO_HOME}/git/checkouts/[name]-[hash]/[short-sha]`).
+    fn git_checkout_root(manifest_path: &camino::Utf8Path) -> Option<Utf8PathBuf> {
+        let components: Vec<&str> = manifest_path.components().map(|c| c.as_str()).collect();
+        let git = components
+            .windows(2)
+            .position(|w| w[0] == "git" && w[1] == "checkouts")?;
+        Some(components.get(..git + 4)?.iter().collect())
+    }
+
+    /// For a git crate in a checkout subdirectory, the nearest ancestor manifest
+    /// with a `[workspace]` table (as cargo finds it), relative to the crate's
+    /// repository: `git_repository` with a `strip_prefix` keeps the whole checkout
+    /// under `.tmp_git_root/`.
+    fn git_workspace_manifest(manifest_path: &camino::Utf8Path) -> Option<String> {
+        let checkout_root = Self::git_checkout_root(manifest_path)?;
+        let package_dir = manifest_path.parent()?;
+        if package_dir == checkout_root {
+            return None;
+        }
+        package_dir
+            .ancestors()
+            .skip(1)
+            .take_while(|dir| dir.starts_with(&checkout_root))
+            .find(|dir| {
+                std::fs::read_to_string(dir.join("Cargo.toml"))
+                    .ok()
+                    .and_then(|text| text.parse::<toml::Table>().ok())
+                    .is_some_and(|table| table.contains_key("workspace"))
+            })
+            .map(|dir| {
+                let relative = dir.strip_prefix(&checkout_root).unwrap().join("Cargo.toml");
+                format!(".tmp_git_root/{}", relative.as_str().replace('\\', "/"))
+            })
+    }
