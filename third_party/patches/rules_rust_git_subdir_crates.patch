+        manifest_path: &camino::Utf8Path,
+        src_path: &camino::Utf8Path,
+    ) -> Option<String> {
+        let checkout_root = Self::git_checkout_root(manifest_path)?;
+
+        // Lexically resolve `..`; cargo reports `src_path` unnormalized.
+        let mut src = Utf8PathBuf::new();
+        for component in src_path.components() {
+            match component {
+                camino::Utf8Component::ParentDir => {
+                    src.pop();
+                }
+                camino::Utf8Component::CurDir => {}
+                other => src.push(other),
+            }
+        }
+        let relative = src.strip_prefix(&checkout_root).ok()?;
+        Some(format!(".tmp_git_root/{}", relative.as_str().replace('\\', "/")))
+    }
