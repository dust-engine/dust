load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")

package(default_visibility = ["//visibility:public"])

macos_application(
    name = "Dust",
    additional_contents = {
        ":kosmickrisp_icd": "Resources/vulkan/icd.d",
        ":vulkan_libraries": "Frameworks",
        "//layers/metal_objects:runtime": "Resources/vulkan/explicit_layer.d",
    },
    bundle_id = "rs.dust.viewer",
    bundle_name = "Dust",
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    minimum_deployment_os_version = "26.0",
    linkopts = [
        # A Rust staticlib cannot carry the #[link] directives recorded in its
        # rlibs, so the frameworks rustc links into //:dust are repeated here.
        "-framework",
        "AppKit",
        "-framework",
        "ApplicationServices",
        "-framework",
        "Carbon",
        "-framework",
        "CloudKit",
        "-framework",
        "ColorSync",
        "-framework",
        "CoreData",
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreGraphics",
        "-framework",
        "CoreImage",
        "-framework",
        "CoreServices",
        "-framework",
        "CoreText",
        "-framework",
        "CoreVideo",
        "-framework",
        "Foundation",
        "-framework",
        "GameController",
        "-framework",
        "Metal",
        "-framework",
        "MetalFX",
        "-framework",
        "QuartzCore",
        "-framework",
        "Security",
        "-framework",
        "UserNotifications",
    ],
    deps = ["//:dust_entry"],
)

# The manifest by which the Vulkan loader finds the Vulkan SDK's KosmicKrisp in the bundle,
# where it's in `Contents/Frameworks`. The loader looks for manifests in
# `Contents/Resources/vulkan/icd.d`, and finds the library by its path relative to the
# manifest.
genrule(
    name = "kosmickrisp_icd",
    srcs = ["@vulkan_sdk//:sdk/share/vulkan/icd.d/libkosmickrisp_icd.json"],
    outs = ["libkosmickrisp_icd.json"],
    cmd = "sed 's#\"library_path\": \"[^\"]*\"#\"library_path\": \"../../../Frameworks/libvulkan_kosmickrisp.dylib\"#' $< > $@",
    target_compatible_with = ["@platforms//os:macos"],
)

# The Vulkan loader and KosmicKrisp. The game doesn't link with them in the bundle, so
# they're copied into it. pumicite opens the loader by this name. They're copied into this
# package first because `additional_contents` keeps a file's path in its package, which
# for the SDK's files would put them in `Contents/Frameworks/sdk/lib`.
genrule(
    name = "vulkan_libraries",
    srcs = [
        "@vulkan_sdk//:sdk/lib/libvulkan.dylib",
        "@vulkan_sdk//:sdk/lib/libvulkan_kosmickrisp.dylib",
    ],
    outs = [
        "libvulkan.dylib",
        "libvulkan_kosmickrisp.dylib",
    ],
    cmd = "cp $(SRCS) $(RULEDIR)",
    target_compatible_with = ["@platforms//os:macos"],
)
