RayTracingPipeline (
    stages: [
        HitGroup (
            ty: Aabbs,
            closest_hit: (
                path: "bazel://dust/crates/vox/shaders/vox_pbr.spv",
                entry_point: "closestHitShader",
            ),
            intersection: (
                path: "bazel://dust/crates/vox/shaders/vox_pbr.spv",
                entry_point: "intersectionShader",
            ),
            param_size: 24
        ),
    ],

    layout: Path("bazel://dust/crates/pbr/shaders/pbr.playout.bin"),
    max_ray_payload_size: 4,
    max_hit_attribute_size: 4,
)
