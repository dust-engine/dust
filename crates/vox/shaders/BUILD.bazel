load("@rules_vulkan//vulkan:defs.bzl", "slang_shader")
load("//third_party:pumicite_cli.bzl", "slang_playout", "ron2bin")

package(default_visibility = ["//visibility:public"])

slang_shader(
    name = "blas_builder_copy_coords",
    srcs = ["blas_builder_copy_coords.slang"],
    out = "blas_builder_copy_coords.spv",
    profile = "cs_6_0",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_playout(
    name = "blas_builder_copy_coords_playout",
    srcs = ["blas_builder_copy_coords.slang"],
    out = "blas_builder_copy_coords.playout.bin",
    set_attrs = [
        "0:push_descriptor"
    ]
)
ron2bin(
    name = "blas_builder_copy_coords_comp_pipeline",
    src = "blas_builder_copy_coords.comp.pipeline.ron",
    out = "blas_builder_copy_coords.comp.pipeline.bin",
    type = "compute-pipeline"
)

slang_shader(
    name = "vox_pbr",
    srcs = ["vox_pbr.slang"],
    hdrs = [
        "//crates/pbr/shaders:pbr_module",
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
    ],
    out = "pbr.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)
ron2bin(
    name = "vox_pbr_rtx_pipeline_library",
    src = "vox_pbr.rtx.pipeline.ron",
    out = "vox_pbr.rtx.pipeline.bin",
    type = "raytracing-pipeline"
)


slang_shader(
    name = "vox_shadow",
    srcs = ["vox_shadow.slang"],
    out = "vox_shadow.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)
ron2bin(
    name = "vox_pbr_shadow_pipeline_library",
    src = "vox_shadow.rtx.pipeline.ron",
    out = "vox_shadow.rtx.pipeline.bin",
    type = "raytracing-pipeline"
)
