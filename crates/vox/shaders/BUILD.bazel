load("@rules_vulkan//vulkan:defs.bzl", "slang_shader")
load("//third_party:pumicite_cli.bzl", "slang_playout", "ron2bin")

package(default_visibility = ["//visibility:public"])

# Shared voxel types (Block, HitAttribute, VoxModelParams,
# ReportHitWithAMDWorkaround). Compiled to a Slang IR module so the voxel hit
# groups (vox_pbr, vox_shadow, vox_final_gather, vox_sharc_update) can import it.
slang_shader(
    name = "vox_common_module",
    srcs = ["vox_common.slang"],
    out = "vox_common.slang-module",
    opts = ["-emit-ir"],
)

slang_shader(
    name = "blas_builder_copy_coords",
    srcs = ["blas_builder_copy_coords.slang"],
    out = "blas_builder_copy_coords.spv",
    profile = "cs_6_0",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_playout(
    name = "blas_builder_copy_coords_playout",
    srcs = ["blas_builder_copy_coords.slang"],
    out = "blas_builder_copy_coords.playout.bin",
    set_attrs = [
        "0:push_descriptor"
    ]
)
ron2bin(
    name = "blas_builder_copy_coords_comp_pipeline",
    src = "blas_builder_copy_coords.comp.pipeline.ron",
    out = "blas_builder_copy_coords.comp.pipeline.bin",
    type = "compute-pipeline"
)

slang_shader(
    name = "vox_pbr",
    srcs = ["vox_pbr.slang"],
    hdrs = [
        ":vox_common_module",
        "//crates/pbr/shaders:pbr_module",
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
    ],
    out = "vox_pbr.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)
ron2bin(
    name = "vox_pbr_rtx_pipeline_library",
    src = "vox_pbr.rtx.pipeline.ron",
    out = "vox_pbr.rtx.pipeline.bin",
    type = "raytracing-pipeline"
)


slang_shader(
    name = "vox_shadow",
    srcs = ["vox_shadow.slang"],
    hdrs = [
        ":vox_common_module",
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        "//crates/pbr/shaders:pbr_module",
    ],
    out = "vox_shadow.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)
ron2bin(
    name = "vox_pbr_shadow_pipeline_library",
    src = "vox_shadow.rtx.pipeline.ron",
    out = "vox_shadow.rtx.pipeline.bin",
    type = "raytracing-pipeline"
)

slang_shader(
    name = "vox_final_gather",
    srcs = ["vox_final_gather.slang"],
    hdrs = [
        ":vox_common_module",
        "//crates/pbr/shaders:pbr_module",
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        "//crates/pbr/shaders:random.slang",
    ],
    out = "vox_final_gather.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)
ron2bin(
    name = "vox_final_gather_pipeline_library",
    src = "vox_final_gather.rtx.pipeline.ron",
    out = "vox_final_gather.rtx.pipeline.bin",
    type = "raytracing-pipeline"
)

# Voxel hit group attached to the SHARC Update RT pipeline. The SHARC state
# machine lives in the ray-gen, not the hit shader.
slang_shader(
    name = "vox_sharc_update",
    srcs = ["vox_sharc_update.slang"],
    hdrs = [
        "//crates/pbr/shaders:pbr_module",
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        "//crates/pbr/shaders:random.slang",
    ],
    out = "vox_sharc_update.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)
ron2bin(
    name = "vox_sharc_update_pipeline_library",
    src = "vox_sharc_update.rtx.pipeline.ron",
    out = "vox_sharc_update.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

filegroup(
    name = "runtime",
    srcs = [
        ":blas_builder_copy_coords",
        ":blas_builder_copy_coords_comp_pipeline",
        ":blas_builder_copy_coords_playout",
        ":vox_pbr",
        ":vox_pbr_rtx_pipeline_library",
        ":vox_pbr_shadow_pipeline_library",
        ":vox_shadow",
        ":vox_final_gather",
        ":vox_final_gather_pipeline_library",
        ":vox_sharc_update",
        ":vox_sharc_update_pipeline_library",
    ],
)
