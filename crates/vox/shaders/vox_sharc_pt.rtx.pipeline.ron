// Voxel hit group attached to the SHARC Update RT pipeline.
// The SHARC state machine lives in the ray-gen.
RayTracingPipeline (
    stages: [
        HitGroup (
            ty: Aabbs,
            closest_hit: (
                path: "bazel://dust/crates/vox/shaders/vox_sharc_pt.spv",
                entry_point: "closestHitShader",
            ),
            intersection: (
                path: "bazel://dust/crates/vox/shaders/vox_sharc_pt.spv",
                entry_point: "intersectionShader",
            ),
            param_size: 32  // VoxModelParams: 3×u64 + f32 + u32 pad = 32 B
        ),
    ],

    layout: Path("bazel://dust/crates/pbr/shaders/sharc/sharc.playout.bin"),
    max_ray_payload_size: 32,
    max_hit_attribute_size: 4,
)
