// Voxel hit group attached to the SHARC Update RT pipeline.
// The SHARC state machine lives in the ray-gen.
RayTracingPipeline (
    stages: [
        HitGroup (
            ty: Aabbs,
            closest_hit: (
                path: "bazel://dust/crates/vox/shaders/vox_sharc_update.spv",
                entry_point: "closestHitShader",
            ),
            intersection: (
                path: "bazel://dust/crates/vox/shaders/vox_sharc_update.spv",
                entry_point: "intersectionShader",
            ),
            param_size: 32  // VoxModelParams: 3×u64 + f32 + u32 pad = 32 B
        ),
    ],

    layout: Path("bazel://dust/crates/pbr/shaders/sharc/sharc.playout.bin"),
    // SharcRayPayload is a single uint — the source candidate's cache slot
    // MUST match the base sharc_update.rtx.pipeline.ron's
    // max_ray_payload_size; a mismatch between linked RT pipeline libraries
    // crashes the driver's pipeline compiler.
    max_ray_payload_size: 4,
    max_hit_attribute_size: 4,
)
