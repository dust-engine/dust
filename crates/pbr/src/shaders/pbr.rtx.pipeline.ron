RayTracingPipeline(
    stages: [
        RayGen (
            shader: (
                path: "embedded://dust_pbr/shaders/pbr.spv",
                entry_point: "rayGenShader"
            )
        ),
        Miss (
            shader: (
                path: "embedded://dust_pbr/shaders/pbr.spv",
                entry_point: "missShader",
            )
        ),
    ],
    max_ray_payload_size: 4,
    max_hit_attribute_size: 4,

    layout: Inline(
        PipelineLayout(
            sets: [
                Inline(
                    DescriptorSetLayout(
                        push_descriptor: true,
                        bindings: [
                            Binding(
                                binding: 0,
                                ty: AccelerationStructure,
                                stages: [RayGen]
                            ),
                            Binding(
                                binding: 1,
                                ty: StorageImage,
                                stages: [Miss, ClosestHit, RayGen]
                            )
                        ]
                    )
                )
            ],
            push_constants: {
                Compute: (0, 4)
            }
        )
    ),
)
