load("@crates//:defs.bzl", "all_crate_deps", "aliases")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
)

# Linkable wrappers around the NGX SDK's `static inline` DLSS-RR helpers, bound
# by `src/upscaler/dlss/sys.rs`.
cc_library(
    name = "ngx_helpers",
    srcs = ["src/upscaler/dlss/ngx_helpers.c"],
    deps = [
        "@dlss//:dlss_headers",
        "@vulkan_sdk//:vulkan_headers",
    ],
)

rust_library(
    name = "dust_pbr",
    crate_name = "dust_pbr",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "//crates/pbr/shaders:pbr_module_layout_macro",
    ],
    edition = "2024",
    aliases = aliases(),
    # DLSS on Windows and Linux; macOS uses MetalFX instead.
    crate_features = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["dlss"],
    }),
    deps = all_crate_deps(normal = True) + [
        "//crates/app:dust_app",
        "//crates/profiler:dust_profiler",
    ],
    link_deps = ["//third_party/ffx:ffx_lpm_cpu"] + select({
        "@platforms//os:macos": [],
        "//conditions:default": [
            ":ngx_helpers",
            "@dlss//:dlss",
        ],
    }),
    rustc_env_files = [
        ":cargo_toml_env_vars",
        "//:bazel_bin_env",
    ],
)
