PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                bindings: [
                    Binding(
                        binding: 0,
                        ty: AccelerationStructure,
                        stages: [RayGen]
                    ),
                    Binding( // Camera Uniforms
                        binding: 1,
                        ty: UniformBuffer,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Output texture
                        binding: 2,
                        ty: StorageImage,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Albedo
                        binding: 3,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Albedo sRGB (sampled read in shadow pass)
                        binding: 4,
                        ty: SampledImage,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Normal
                        binding: 5,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Depth
                        binding: 6,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Occlusion
                        binding: 7,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Motion vectors (R16G16_SFLOAT)
                        binding: 8,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Atmosphere Uniform
                        binding: 9,
                        ty: UniformBuffer,
                        stages: [RayGen, Miss]
                    ),
                    Binding( // Transmittance
                        binding: 10,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding( // SkyView
                        binding: 11,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding( // Linear Sampler
                        binding: 12,
                        ty: Sampler,
                        stages: [Miss, RayGen]
                    ),
                    Binding( // Per-instance previous-frame transforms (PbrInstanceData[])
                        binding: 13,
                        ty: StorageBuffer,
                        stages: [ClosestHit]
                    ),
                ]
            )
        ),
    ],
    push_constants: {
        RayGen: (0, 4),
    }
)
