PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                bindings: [
                    Binding(
                        binding: 0,
                        ty: AccelerationStructure,
                        stages: [RayGen]
                    ),
                    Binding( // Camera Uniforms
                        binding: 1,
                        ty: UniformBuffer,
                        stages: [Miss, ClosestHit, RayGen, Compute]
                    ),
                    Binding( // Output texture
                        binding: 2,
                        ty: StorageImage,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Albedo
                        binding: 3,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Albedo sRGB (sampled read in shadow pass)
                        binding: 4,
                        ty: SampledImage,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Normal
                        binding: 5,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit, Compute]
                    ),
                    Binding( // Depth
                        binding: 6,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit, Compute]
                    ),
                    Binding( // Occlusion (also written by the SHARC occupancy
                             // debug compute pass — see sharc_occupancy.slang)
                        binding: 7,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit, Compute]
                    ),
                    Binding( // Motion vectors (R16G16_SFLOAT)
                        binding: 8,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit, Compute]
                    ),
                    Binding( // Atmosphere Uniform
                        binding: 9,
                        ty: UniformBuffer,
                        stages: [RayGen, Miss]
                    ),
                    Binding( // Transmittance
                        binding: 10,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding( // SkyView
                        binding: 11,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding( // Linear Sampler
                        binding: 12,
                        ty: Sampler,
                        stages: [Miss, RayGen]
                    ),
                    Binding( // Per-instance previous-frame transforms (PbrInstanceData[])
                        binding: 13,
                        ty: StorageBuffer,
                        stages: [ClosestHit]
                    ),

                    // SHARC working storage. Queried by the vox_final_gather
                    // closest hit (folds cached indirect into HDR) and by the
                    // vox_pbr primary closest hit (debug visualization —
                    // SharcShaderConstants::debugMode). Bindings mirror
                    // sharc.playout.ron exactly so the same Slang reflection
                    // assignments align across pipelines.
                    // hashEntries + constants are also read by the SHARC
                    // occupancy debug compute pass (sharc_occupancy.slang),
                    // hence the extra Compute stage on 14 / 17.
                    Binding(binding: 14, ty: StorageBuffer, stages: [RayGen, ClosestHit, Compute]), // hashEntries
                    Binding(binding: 15, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // accumulation
                    Binding(binding: 16, ty: StorageBuffer, stages: [RayGen, ClosestHit, Compute]), // resolved
                    Binding(binding: 17, ty: UniformBuffer, stages: [RayGen, ClosestHit, Miss, Compute]), // SHARC constants
                    // Candidate pool (ping-ponged each frame). Read side is
                    // unused in the final-gather pipeline (the pool is only
                    // *written* from this side — vox_final_gather CHS pushes
                    // on cache miss); we declare it to keep Slang reflection
                    // slots aligned with sharc.playout.ron.
                    // Compute: the candidate-pool splat debug view reads these
                    // (the host binds the side it wants to visualize here).
                    Binding(binding: 18, ty: StorageBuffer, stages: [RayGen, Compute]),    // candidates_read
                    Binding(binding: 19, ty: StorageBuffer, stages: [RayGen, Compute]),    // keys_read
                    Binding(binding: 20, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // candidates_write
                    Binding(binding: 21, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // keys_write
                ]
            )
        ),
    ],
    push_constants: {
        // FinalGatherPush: just frameIndex (see final_gather.slang). The
        // primary/shadow pipelines share this layout but declare no push
        // constants of their own.
        RayGen: (0, 4),
    }
)
