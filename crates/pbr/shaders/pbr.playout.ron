PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                bindings: [
                    Binding(
                        binding: 0,
                        ty: AccelerationStructure,
                        stages: [RayGen]
                    ),
                    Binding( // Camera Uniforms
                        binding: 1,
                        ty: UniformBuffer,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Output texture
                        binding: 2,
                        ty: StorageImage,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Albedo
                        binding: 3,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Albedo sRGB (sampled read in shadow pass)
                        binding: 4,
                        ty: SampledImage,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding( // Normal
                        binding: 5,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Depth
                        binding: 6,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Occlusion
                        binding: 7,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Motion vectors (R16G16_SFLOAT)
                        binding: 8,
                        ty: StorageImage,
                        stages: [RayGen, Miss, ClosestHit]
                    ),
                    Binding( // Atmosphere Uniform
                        binding: 9,
                        ty: UniformBuffer,
                        stages: [RayGen, Miss]
                    ),
                    Binding( // Transmittance
                        binding: 10,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding( // SkyView
                        binding: 11,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding( // Linear Sampler
                        binding: 12,
                        ty: Sampler,
                        stages: [Miss, RayGen]
                    ),
                    Binding( // Per-instance previous-frame transforms (PbrInstanceData[])
                        binding: 13,
                        ty: StorageBuffer,
                        stages: [ClosestHit]
                    ),

                    // SHARC working storage. Used by the final-gather ray-gen
                    // (no-op currently — payload-side path) and by the
                    // vox_final_gather closest hit, which queries the resolved
                    // cache at the gather-ray hit to fold cached indirect into
                    // HDR. Bindings mirror sharc.playout.ron exactly so the
                    // same Slang reflection assignments align across
                    // pipelines.
                    Binding(binding: 14, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // hashEntries
                    Binding(binding: 15, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // accumulation
                    Binding(binding: 16, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // resolved
                    Binding(binding: 17, ty: UniformBuffer, stages: [RayGen, ClosestHit]), // SHARC constants
                    // Candidate pool (ping-ponged each frame). Read side is
                    // unused in the final-gather pipeline (the pool is only
                    // *written* from this side — vox_final_gather CHS pushes
                    // on cache miss); we declare it to keep Slang reflection
                    // slots aligned with sharc.playout.ron.
                    Binding(binding: 18, ty: StorageBuffer, stages: [RayGen]),             // candidates_read (unused)
                    Binding(binding: 19, ty: StorageBuffer, stages: [RayGen]),             // keys_read (unused)
                    Binding(binding: 20, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // candidates_write
                    Binding(binding: 21, ty: StorageBuffer, stages: [RayGen, ClosestHit]), // keys_write
                ]
            )
        ),
    ],
    push_constants: {
        // FinalGatherPush: frameIndex + SHARC debug params (see final_gather.slang).
        RayGen: (0, 24),
    }
)
