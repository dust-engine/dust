PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                // Stages mirror the [Stages(...)] attribute on each
                // PbrPipelineParams binding (pbr_common.slang): the per-binding
                // UNION of stages across the engine's pipelines. The codegen
                // coalesces consecutive same-type bindings into one
                // VkWriteDescriptorSet only when this mask matches, so every
                // coalesced write is stage-uniform.
                bindings: [
                    Binding(binding: 0,  ty: AccelerationStructure, stages: [RayGen]),
                    Binding(binding: 1,  ty: UniformBuffer,         stages: [RayGen, Miss, ClosestHit, Compute]),  // camera uniforms
                    Binding(binding: 2,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // output
                    Binding(binding: 3,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),           // albedo (linear view)
                    Binding(binding: 4,  ty: SampledImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // albedo (sRGB view)
                    Binding(binding: 5,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),           // albedo (Uint view)
                    Binding(binding: 6,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // normal
                    Binding(binding: 7,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // depth
                    Binding(binding: 8,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // occlusion
                    Binding(binding: 9,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // motion vectors
                    Binding(binding: 10,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),           // specular albedo
                    Binding(binding: 11, ty: UniformBuffer,         stages: [RayGen, Miss, Compute]),              // atmosphere
                    Binding(binding: 12, ty: SampledImage,          stages: [RayGen, Miss, Compute]),              // transmittance LUT
                    Binding(binding: 13, ty: SampledImage,          stages: [RayGen, Miss, Compute]),              // sky-view LUT
                    Binding(binding: 14, ty: Sampler,               stages: [RayGen, Miss, Compute]),              // linear sampler
                    Binding(binding: 15, ty: StorageBuffer,         stages: [ClosestHit]),                         // per-instance transforms
                    // Screen-space gather trace (pbr_common.slang, screen_trace.slang).
                    // The Apple driver allows 32 bindings in a push-descriptor set.
                    Binding(binding: 16, ty: SampledImage,          stages: [Compute]),                            // HZB
                    Binding(binding: 17, ty: SampledImage,          stages: [Compute]),                            // previous scene color
                    Binding(binding: 18, ty: SampledImage,          stages: [Compute]),                            // previous depth
                    Binding(binding: 19, ty: UniformBuffer,         stages: [Compute]),                            // ScreenTraceConstants
                    Binding(binding: 20, ty: StorageImage,          stages: [Compute]),                            // trace hit records
                    Binding(binding: 21, ty: StorageBuffer,         stages: [Compute]),                            // compacted trace texels
                    Binding(binding: 22, ty: StorageBuffer,         stages: [Compute]),                            // compacted trace args (indirect)
                    // Radiance cascades (pbr_common.slang).
                    Binding(binding: 23, ty: UniformBuffer,         stages: [Compute]),                            // RcConstants
                ]
            )
        ),
    ],
    // Start and end of each stage's range, kept apart: a push must name every stage
    // whose range overlaps it, and each of those must cover all of it.
    push_constants: {
        // A per-frame frameIndex sampling seed. Pushed by the shadow pass
        // (ShadowPush, shadow.slang); the primary pipeline shares this layout
        // but declares no push constants of its own.
        RayGen: (0, 4),
        // The cascade a radiance cascades compute pass works on (RcPush,
        // rc_common.slang).
        Compute: (4, 8),
    }
)
