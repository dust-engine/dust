PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                bindings: [
                    Binding( // hdrInput
                        binding: 0,
                        ty: StorageImage,
                        stages: [Compute],
                    ),
                    Binding( // ldrOutput
                        binding: 1,
                        ty: StorageImage,
                        stages: [Compute],
                    ),
                    Binding( // sdrInput, through its sRGB view
                        binding: 2,
                        ty: SampledImage,
                        stages: [Compute],
                    ),
                    Binding( // LPM control block (uvec4 ctl[24])
                        binding: 3,
                        ty: UniformBuffer,
                        stages: [Compute],
                    ),
                    Binding( // exposureInput (1x1 auto-exposure scale)
                        binding: 4,
                        ty: StorageImage,
                        stages: [Compute],
                    ),
                ],
            ),
        ),
    ],
    push_constants: {},
)
