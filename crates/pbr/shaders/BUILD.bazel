load("@rules_vulkan//vulkan:defs.bzl", "slang_shader")
load("//third_party:slang_playout.bzl", "ron2bin")

package(default_visibility = ["//visibility:public"])

slang_shader(
    name = "pbr",
    srcs = ["pbr.slang"],
    hdrs = ["//crates/pbr/shaders/sky_atmosphere:atmosphere_common.slang"],
    out = "pbr.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_shader(
    name = "shadow",
    srcs = ["shadow.slang"],
    hdrs = ["//crates/pbr/shaders/sky_atmosphere:atmosphere_common.slang"],
    out = "shadow.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_shader(
    name = "tonemap",
    srcs = ["tonemap.slang"],
    out = "tonemap.spv",
    profile = "cs_6_0",
    target = "spirv",
    opts = ["-O3"],
)

ron2bin(
    name = "pbr_rtx_pipeline",
    src = "pipeline/pbr.rtx.pipeline.ron",
    out = "pbr.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

ron2bin(
    name = "pbr_playout",
    src = "pipeline/pbr.playout.ron",
    out = "pbr.playout.bin",
    type = "pipeline-layout",
)

ron2bin(
    name = "shadow_rtx_pipeline",
    src = "pipeline/shadow.rtx.pipeline.ron",
    out = "shadow.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

ron2bin(
    name = "tonemap_comp_pipeline",
    src = "pipeline/tonemap.comp.pipeline.ron",
    out = "tonemap.comp.pipeline.bin",
    type = "compute-pipeline",
)
