load("@rules_vulkan//vulkan:defs.bzl", "glsl_shader", "slang_shader")
load("//third_party:pumicite_cli.bzl", "ron2bin", "slang_playout")

package(default_visibility = ["//visibility:public"])

slang_shader(
    name = "pbr_module",
    srcs = ["pbr_common.slang"],
    out = "pbr_common.slang-module",
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module"
    ],
    opts = ["-emit-ir"]
)

slang_playout(
    name = "pbr_module_layout_macro",
    srcs = ["pbr_common.slang"],
    out = "pbr_module_layout.rs",
    format = "codegen",
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module"
    ],
)

slang_shader(
    name = "pbr",
    srcs = ["pbr.slang"],
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
    ],
    out = "pbr.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_shader(
    name = "shadow",
    srcs = ["shadow.slang"],
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
    ],
    out = "shadow.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

ron2bin(
    name = "pbr_rtx_pipeline",
    src = "pbr.rtx.pipeline.ron",
    out = "pbr.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

ron2bin(
    name = "pbr_playout",
    src = "pbr.playout.ron",
    out = "pbr.playout.bin",
    type = "pipeline-layout",
)

ron2bin(
    name = "shadow_rtx_pipeline",
    src = "shadow.rtx.pipeline.ron",
    out = "shadow.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

slang_shader(
    name = "final_gather",
    srcs = ["final_gather.slang"],
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
        ":random.slang",
    ],
    out = "final_gather.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

ron2bin(
    name = "final_gather_rtx_pipeline",
    src = "final_gather.rtx.pipeline.ron",
    out = "final_gather.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

glsl_shader(
    name = "tonemap",
    src = "tonemap.glsl",
    stage = "compute",
    hdrs = [
        "//third_party/ffx:ffx_lpm_headers",
    ],
    target_env = "vulkan1.2",
)

ron2bin(
    name = "tonemap_comp_pipeline",
    src = "tonemap.comp.pipeline.ron",
    out = "tonemap.comp.pipeline.bin",
    type = "compute-pipeline",
)

ron2bin(
    name = "tonemap_playout",
    src = "tonemap.playout.ron",
    out = "tonemap.playout.bin",
    type = "pipeline-layout",
)

filegroup(
    name = "runtime",
    srcs = [
        ":pbr",
        ":pbr_playout",
        ":pbr_rtx_pipeline",
        ":shadow",
        ":shadow_rtx_pipeline",
        ":final_gather",
        ":final_gather_rtx_pipeline",
        ":tonemap",
        ":tonemap_comp_pipeline",
        ":tonemap_playout",
    ],
)
