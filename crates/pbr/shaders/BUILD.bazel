load("@rules_vulkan//vulkan:defs.bzl", "slang_shader")

package(default_visibility = ["//visibility:public"])

slang_shader(
    name = "pbr",
    srcs = ["pbr.slang"],
    hdrs = ["//crates/pbr/shaders/sky_atmosphere:atmosphere_common.slang"],
    out = "pbr.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_shader(
    name = "shadow",
    srcs = ["shadow.slang"],
    hdrs = ["//crates/pbr/shaders/sky_atmosphere:atmosphere_common.slang"],
    out = "shadow.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_shader(
    name = "tonemap",
    srcs = ["tonemap.slang"],
    out = "tonemap.spv",
    profile = "cs_6_0",
    target = "spirv",
    opts = ["-O3"],
)

[genrule(
    name = ron.replace(".", "_"),
    srcs = ["pipeline/" + ron],
    outs = [ron],
    cmd = "cp $< $@",
    cmd_bat = "copy /Y $< $@",
) for ron in [
    "pbr.rtx.pipeline.ron",
    "pbr.playout.ron",
    "shadow.rtx.pipeline.ron",
    "tonemap.comp.pipeline.ron",
]]
