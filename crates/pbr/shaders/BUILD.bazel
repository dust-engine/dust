load("@rules_vulkan//vulkan:defs.bzl", "glsl_shader", "slang_shader")
load("//third_party:pumicite_cli.bzl", "ron2bin", "slang_playout")

package(default_visibility = ["//visibility:public"])

slang_shader(
    name = "pbr_module",
    srcs = ["pbr_common.slang"],
    out = "pbr_common.slang-module",
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
    ],
    opts = ["-emit-ir"]
)

slang_playout(
    name = "pbr_module_layout_macro",
    srcs = ["pbr_common.slang"],
    out = "pbr_module_layout.rs",
    format = "codegen",
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
    ],
)

slang_shader(
    name = "pbr",
    srcs = ["pbr.slang"],
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
    ],
    out = "pbr.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_shader(
    name = "shadow",
    srcs = ["shadow.slang"],
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
        ":random.slang",
    ],
    out = "shadow.spv",
    profile = "lib_6_3",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

ron2bin(
    name = "pbr_rtx_pipeline",
    src = "pbr.rtx.pipeline.ron",
    out = "pbr.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

ron2bin(
    name = "pbr_playout",
    src = "pbr.playout.ron",
    out = "pbr.playout.bin",
    type = "pipeline-layout",
)

ron2bin(
    name = "shadow_rtx_pipeline",
    src = "shadow.rtx.pipeline.ron",
    out = "shadow.rtx.pipeline.bin",
    type = "raytracing-pipeline",
)

# The gather ray direction (gather_common.slang).
slang_shader(
    name = "gather_module",
    srcs = ["gather_common.slang"],
    out = "gather_common.slang-module",
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
        ":random.slang",
    ],
    opts = ["-emit-ir"],
)

# Screen-space gather trace, compaction and debug overlay: three compute entry
# points in one module (screen_trace.slang), all on the RT pipeline layout.
slang_shader(
    name = "screen_trace",
    srcs = ["screen_trace.slang"],
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
        ":gather_module",
        ":random.slang",
    ],
    out = "screen_trace.spv",
    profile = "sm_6_6",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
        "-fvk-use-entrypoint-name",
        "-entry",
        "main",
        "-stage",
        "compute",
        "-entry",
        "compact",
        "-stage",
        "compute",
        "-entry",
        "debugOverlay",
        "-stage",
        "compute",
    ],
)
ron2bin(
    name = "screen_trace_comp_pipeline",
    src = "screen_trace.comp.pipeline.ron",
    out = "screen_trace.comp.pipeline.bin",
    type = "compute-pipeline",
)
ron2bin(
    name = "screen_trace_compact_comp_pipeline",
    src = "screen_trace_compact.comp.pipeline.ron",
    out = "screen_trace_compact.comp.pipeline.bin",
    type = "compute-pipeline",
)
ron2bin(
    name = "screen_trace_debug_comp_pipeline",
    src = "screen_trace_debug.comp.pipeline.ron",
    out = "screen_trace_debug.comp.pipeline.bin",
    type = "compute-pipeline",
)

# Radiance cascades: the probe build's four compute passes and the debug
# overlay, in one module (radiance_cascades.slang), all on the RT pipeline
# layout.
slang_shader(
    name = "radiance_cascades",
    srcs = ["radiance_cascades.slang"],
    hdrs = [
        "//crates/pbr/shaders/sky_atmosphere:sky_atmosphere_module",
        ":pbr_module",
    ],
    out = "radiance_cascades.spv",
    profile = "sm_6_6",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
        "-fvk-use-entrypoint-name",
        "-entry",
        "rcInsertPixels",
        "-stage",
        "compute",
        "-entry",
        "rcAllocate",
        "-stage",
        "compute",
        "-entry",
        "rcWriteArgs",
        "-stage",
        "compute",
        "-entry",
        "rcInsertParents",
        "-stage",
        "compute",
        "-entry",
        "rcDebugOverlay",
        "-stage",
        "compute",
    ],
)
ron2bin(
    name = "rc_insert_pixels_comp_pipeline",
    src = "rc_insert_pixels.comp.pipeline.ron",
    out = "rc_insert_pixels.comp.pipeline.bin",
    type = "compute-pipeline",
)
ron2bin(
    name = "rc_allocate_comp_pipeline",
    src = "rc_allocate.comp.pipeline.ron",
    out = "rc_allocate.comp.pipeline.bin",
    type = "compute-pipeline",
)
ron2bin(
    name = "rc_write_args_comp_pipeline",
    src = "rc_write_args.comp.pipeline.ron",
    out = "rc_write_args.comp.pipeline.bin",
    type = "compute-pipeline",
)
ron2bin(
    name = "rc_insert_parents_comp_pipeline",
    src = "rc_insert_parents.comp.pipeline.ron",
    out = "rc_insert_parents.comp.pipeline.bin",
    type = "compute-pipeline",
)
ron2bin(
    name = "rc_debug_comp_pipeline",
    src = "rc_debug.comp.pipeline.ron",
    out = "rc_debug.comp.pipeline.bin",
    type = "compute-pipeline",
)

# Closest-depth HZB build: one compute dispatch for the whole mip chain
# (hzb_build.slang). Own layout, auto-derived from the shader's bindings.
slang_shader(
    name = "hzb_build",
    srcs = ["hzb_build.slang"],
    out = "hzb_build.spv",
    profile = "cs_6_6",
    target = "spirv",
    opts = [
        "-O3",
        "-matrix-layout-row-major",
    ],
)

slang_playout(
    name = "hzb_build_layout",
    srcs = ["hzb_build.slang"],
    out = "hzb_build.playout.bin",
    set_attrs = ["0:push_descriptor"],
)

ron2bin(
    name = "hzb_build_comp_pipeline",
    src = "hzb_build.comp.pipeline.ron",
    out = "hzb_build.comp.pipeline.bin",
    type = "compute-pipeline",
)

glsl_shader(
    name = "tonemap",
    src = "tonemap.glsl",
    stage = "compute",
    hdrs = [
        "//third_party/ffx:ffx_lpm_headers",
    ],
    target_env = "vulkan1.2",
)

ron2bin(
    name = "tonemap_comp_pipeline",
    src = "tonemap.comp.pipeline.ron",
    out = "tonemap.comp.pipeline.bin",
    type = "compute-pipeline",
)

ron2bin(
    name = "tonemap_playout",
    src = "tonemap.playout.ron",
    out = "tonemap.playout.bin",
    type = "pipeline-layout",
)

glsl_shader(
    name = "autoexposure",
    src = "autoexposure.glsl",
    stage = "compute",
    target_env = "vulkan1.2",
)

ron2bin(
    name = "autoexposure_comp_pipeline",
    src = "autoexposure.comp.pipeline.ron",
    out = "autoexposure.comp.pipeline.bin",
    type = "compute-pipeline",
)

ron2bin(
    name = "autoexposure_playout",
    src = "autoexposure.playout.ron",
    out = "autoexposure.playout.bin",
    type = "pipeline-layout",
)

filegroup(
    name = "runtime",
    srcs = [
        ":pbr",
        ":pbr_playout",
        ":pbr_rtx_pipeline",
        ":shadow",
        ":shadow_rtx_pipeline",
        ":hzb_build",
        ":hzb_build_layout",
        ":hzb_build_comp_pipeline",
        ":screen_trace",
        ":screen_trace_comp_pipeline",
        ":screen_trace_compact_comp_pipeline",
        ":screen_trace_debug_comp_pipeline",
        ":radiance_cascades",
        ":rc_insert_pixels_comp_pipeline",
        ":rc_allocate_comp_pipeline",
        ":rc_write_args_comp_pipeline",
        ":rc_insert_parents_comp_pipeline",
        ":rc_debug_comp_pipeline",
        ":tonemap",
        ":tonemap_comp_pipeline",
        ":tonemap_playout",
        ":autoexposure",
        ":autoexposure_comp_pipeline",
        ":autoexposure_playout",
    ],
)
