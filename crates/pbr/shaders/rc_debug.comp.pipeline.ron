// Radiance cascades compute pass (rc_debug.slang, entry `rcDebugOverlay`). Shares the ray
// tracing pipeline layout (pbr.playout.bin).
ComputePipeline(
    shader: (
        path: "bazel://dust/crates/pbr/shaders/rc_debug.spv",
        entry_point: "rcDebugOverlay",
    ),
    layout: Path("bazel://dust/crates/pbr/shaders/pbr.playout.bin"),
    disable_optimization: false,
)
