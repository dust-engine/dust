// SHARC ray-tracing pipeline layout (Update pass).
//
// Same shared ParameterBlock as pbr.playout.ron, so the binding stages are
// IDENTICAL here — the per-binding union of stages across the engine's pipelines,
// mirroring the [Stages(...)] attribute in pbr_common.slang / sharc.slang. The
// codegen coalesces consecutive same-type bindings only within a matching-stage
// run, keeping every coalesced VkWriteDescriptorSet stage-uniform.
PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                bindings: [
                    Binding(binding: 0,  ty: AccelerationStructure, stages: [RayGen]),
                    Binding(binding: 1,  ty: UniformBuffer,         stages: [RayGen, Miss, ClosestHit, Compute]),  // camera uniforms
                    Binding(binding: 2,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),           // output
                    Binding(binding: 3,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),           // albedo (linear view)
                    Binding(binding: 4,  ty: SampledImage,          stages: [RayGen, Miss, ClosestHit]),           // albedo (sRGB view)
                    Binding(binding: 5,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),           // albedo (Uint view) (unused here)
                    Binding(binding: 6,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // normal
                    Binding(binding: 7,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // depth
                    Binding(binding: 8,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // occlusion
                    Binding(binding: 9,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit, Compute]),  // motion vectors
                    Binding(binding: 10, ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),           // specular albedo (unused here)
                    Binding(binding: 11, ty: UniformBuffer,         stages: [RayGen, Miss]),                       // atmosphere
                    Binding(binding: 12, ty: SampledImage,          stages: [RayGen, Miss]),                       // transmittance LUT
                    Binding(binding: 13, ty: SampledImage,          stages: [RayGen, Miss]),                       // sky-view LUT
                    Binding(binding: 14, ty: Sampler,               stages: [RayGen, Miss]),                       // linear sampler
                    Binding(binding: 15, ty: StorageBuffer,         stages: [ClosestHit]),                         // per-instance transforms
                    Binding(binding: 16, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit, Compute]),  // SHARC hashEntries
                    Binding(binding: 17, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit]),           // SHARC accumulation
                    Binding(binding: 18, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit, Compute]),  // SHARC resolved
                    Binding(binding: 19, ty: UniformBuffer,         stages: [RayGen, Miss, ClosestHit, Compute]),  // SHARC constants
                    Binding(binding: 20, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit, Compute]),  // candidates_read
                    Binding(binding: 21, ty: StorageBuffer,         stages: [RayGen, Compute]),                    // keys_read
                    Binding(binding: 22, ty: StorageBuffer,         stages: [RayGen, ClosestHit]),                 // candidates_write
                    Binding(binding: 23, ty: StorageBuffer,         stages: [RayGen, ClosestHit]),                 // keys_write
                ]
            )
        ),
    ],
    push_constants: {
        // sharc_pt.slang push_constant: { uint frameIndex; }
        RayGen: (0, 4),
    }
)
