// SHARC ray-tracing pipeline layout (Update pass).
//
// Single descriptor set: bindings 0..13 mirror pbr.playout.ron exactly (the
// `pbr_common::params` ParameterBlock is pinned to set 0 — see pbr_common.slang),
// bindings 14..17 are the SHARC working storage, 18..21 the ping-ponged
// candidate pool. Vulkan permits only one push-descriptor set per pipeline
// layout, so collapsing everything into one set is the simplest correct choice.
PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                bindings: [
                    // PbrPipelineParams (mirrors pbr.playout.ron set 0).
                    Binding(binding: 0,  ty: AccelerationStructure, stages: [RayGen]),
                    Binding(binding: 1,  ty: UniformBuffer,         stages: [Miss, ClosestHit, RayGen]),
                    Binding(binding: 2,  ty: StorageImage,          stages: [Miss, ClosestHit, RayGen]),
                    Binding(binding: 3,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),
                    Binding(binding: 4,  ty: SampledImage,          stages: [Miss, ClosestHit, RayGen]),
                    Binding(binding: 5,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),
                    Binding(binding: 6,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),
                    Binding(binding: 7,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),
                    Binding(binding: 8,  ty: StorageImage,          stages: [RayGen, Miss, ClosestHit]),
                    Binding(binding: 9,  ty: UniformBuffer,         stages: [RayGen, Miss]),
                    Binding(binding: 10, ty: SampledImage,          stages: [Miss, RayGen]),
                    Binding(binding: 11, ty: SampledImage,          stages: [Miss, RayGen]),
                    Binding(binding: 12, ty: Sampler,               stages: [Miss, RayGen]),
                    Binding(binding: 13, ty: StorageBuffer,         stages: [ClosestHit]),

                    // SHARC additions.
                    Binding(binding: 14, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit]),  // hashEntries
                    Binding(binding: 15, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit]),  // accumulation
                    Binding(binding: 16, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit]),  // resolved
                    Binding(binding: 17, ty: UniformBuffer,         stages: [RayGen, Miss, ClosestHit]),  // SHARC constants
                    // Candidate pool (ping-ponged each frame).
                    Binding(binding: 18, ty: StorageBuffer,         stages: [RayGen, Miss, ClosestHit]),  // candidates_read
                    Binding(binding: 19, ty: StorageBuffer,         stages: [RayGen]),                    // keys_read
                    // Write side: final_gather CHS pushes on cache miss;
                    // Update raygen pushes on cascade miss.
                    Binding(binding: 20, ty: StorageBuffer,         stages: [RayGen, ClosestHit]),        // candidates_write
                    Binding(binding: 21, ty: StorageBuffer,         stages: [RayGen, ClosestHit]),        // keys_write
                ]
            )
        ),
    ],
    push_constants: {
        // sharc_pt.slang push_constant: { uint frameIndex; }
        RayGen: (0, 4),
    }
)
