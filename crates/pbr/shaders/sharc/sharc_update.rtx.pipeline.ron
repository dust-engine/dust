// SHARC Update RT pipeline. Sparse cache-population pass; writes only to SHARC
// buffers (AGENTS.md §15).
RayTracingPipeline(
    stages: [
        RayGen (
            shader: (
                path: "bazel://dust/crates/pbr/shaders/sharc/sharc_pt_update.spv",
                entry_point: "rayGenShader"
            )
        ),
        // Miss index 0: bounce-ray miss (sets payload.t = -1).
        Miss (
            shader: (
                path: "bazel://dust/crates/pbr/shaders/sharc/sharc_pt_update.spv",
                entry_point: "primaryMissShader",
            )
        ),
        // Miss index 1: shadow-ray miss (sun visible).
        Miss (
            shader: (
                path: "bazel://dust/crates/pbr/shaders/sharc/sharc_pt_update.spv",
                entry_point: "shadowMissShader",
            )
        ),
    ],
    // SharcHitPayload: float t + float3 albedo + float3 normal + uint64_t key.
    // The 8-aligned key pushes the block past 32 B, so we size to 64 (also a
    // safe margin for whatever offsets Slang assigns). MUST match the linked
    // vox_sharc_pt hit-group library's max_ray_payload_size, or RT pipeline
    // linking crashes the driver. SharcShadowPayload (4 B) is covered too.
    max_ray_payload_size: 64,
    max_hit_attribute_size: 4,

    layout: Path("bazel://dust/crates/pbr/shaders/sharc/sharc.playout.bin"),
)
