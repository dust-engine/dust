PipelineLayout(
    sets: [
        Inline(
            DescriptorSetLayout(
                push_descriptor: true,
                bindings: [
                    Binding(
                        binding: 0,
                        ty: AccelerationStructure,
                        stages: [RayGen]
                    ),
                    Binding(
                        binding: 1,
                        ty: StorageImage,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding(
                        binding: 2,
                        ty: UniformBuffer,
                        stages: [Miss, ClosestHit, RayGen]
                    ),
                    Binding(
                        binding: 3,
                        ty: UniformBuffer,
                        stages: [Miss]
                    ),
                    Binding(
                        binding: 4,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding(
                        binding: 5,
                        ty: SampledImage,
                        stages: [Miss]
                    ),
                    Binding(
                        binding: 6,
                        ty: Sampler,
                        stages: [Miss]
                    ),
                    Binding(
                        binding: 7,
                        ty: StorageImage,
                        stages: [RayGen]
                    ),
                ]
            )
        )
    ],
    push_constants: {
        RayGen: (0, 4)
    }
)
