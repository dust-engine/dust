// Radiance cascades compute pass (rc_build.slang, entry `rcLink`). Shares the ray
// tracing pipeline layout (pbr.playout.bin).
ComputePipeline(
    shader: (
        path: "bazel://dust/crates/pbr/shaders/rc_build.spv",
        entry_point: "rcLink",
    ),
    layout: Path("bazel://dust/crates/pbr/shaders/pbr.playout.bin"),
    disable_optimization: false,
)
