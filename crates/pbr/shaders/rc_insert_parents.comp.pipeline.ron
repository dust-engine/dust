// Radiance cascades compute pass (radiance_cascades.slang, entry
// `rcInsertParents`). Shares the ray tracing pipeline layout (pbr.playout.bin).
ComputePipeline(
    shader: (
        path: "bazel://dust/crates/pbr/shaders/radiance_cascades.spv",
        entry_point: "rcInsertParents",
    ),
    layout: Path("bazel://dust/crates/pbr/shaders/pbr.playout.bin"),
    disable_optimization: false,
)
