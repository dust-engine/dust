module(
    name = "dust",
    version = "0.1.0",
)

# -----------------------------------------------------------------------------
# Vulkan SDK
# -----------------------------------------------------------------------------
bazel_dep(name = "apple_support", version = "2.6.1", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_vulkan", version = "0.7.0")

VULKAN_SDK_VERSION = "1.4.341.1"

vulkan_sdk = use_extension("@rules_vulkan//vulkan:extensions.bzl", "vulkan_sdk")

vulkan_sdk.toolchain(version = VULKAN_SDK_VERSION)
use_repo(vulkan_sdk, vulkan_sdk = "vulkan_sdk_" + VULKAN_SDK_VERSION)

register_toolchains("@vulkan_sdk//:all")

git_override(
    module_name = "rules_vulkan",
    remote = "https://github.com/mxpv/rules_vulkan.git",
    commit = "91b9e9a26615000f86322c2798f0e06ecf11219a",
)

# -----------------------------------------------------------------------------
# shader-slang Rust bindings (external git repo with custom BUILD overlay)
# -----------------------------------------------------------------------------

new_git_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "new_git_repository",
)

new_git_repository(
    name = "vma",
    remote = "https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git",
    tag = "v3.3.0",
    build_file = "//third_party:vma.BUILD.bazel",
)

new_git_repository(
    name = "slang_rs",
    remote = "https://github.com/FloatyMonkey/slang-rs.git",
    commit = "4af0e9db151b9b8f52fa53390f13f3377e8e7df2",
    build_file = "//third_party:slang_rs.BUILD.bazel",
)

# -----------------------------------------------------------------------------
# Rust assetbuild dependency
# -----------------------------------------------------------------------------

bazel_dep(name = "rules_rust", version = "0.74.0")

# Local patches on rules_rust:
#
# * rules_rust_splice_external_path_deps.patch: crate_universe splices the root
#   Cargo.toml into a temporary directory (whose entries are symlinks back into
#   this workspace) before running `cargo metadata`. Relative `path` dependencies
#   that leave the workspace (`../avian`, `../parry`, the `[patch]` entries) then
#   resolve against the temp dir and cargo fails with "failed to read
#   <tmp>/../avian/crates/avian3d/Cargo.toml". The patch rewrites such escaping
#   paths in the spliced root manifest to absolute paths. Not fixed upstream
#   (bazelbuild/rules_rust#2906 was closed without a fix).
# * rules_rust_bootstrap_cargo_bazel.patch: the release ships a prebuilt
#   `cargo-bazel` binary, which would not contain the fix above. Emptying the
#   download table makes rules_rust build `cargo-bazel` from its (patched)
#   sources via `@cargo_bazel_bootstrap` instead. One-time cost per output base.
# * rules_rust_git_subdir_crates.patch: for a git crate in a checkout
#   subdirectory, git_repository's `strip_prefix` keeps the full checkout under
#   `.tmp_git_root/`. The patch uses it for (a) a target source outside the
#   crate directory (avian3d's `../../src/lib.rs` is otherwise rendered as an
#   invalid `..` label) and (b) the workspace manifest that `*.workspace = true`
#   fields inherit from (parry3d's `readme.workspace` otherwise fails
#   `cargo_toml_env_vars`).
single_version_override(
    module_name = "rules_rust",
    patches = [
        "//third_party:patches/rules_rust_splice_external_path_deps.patch",
        "//third_party:patches/rules_rust_git_subdir_crates.patch",
        "//third_party:patches/rules_rust_bootstrap_cargo_bazel.patch",
    ],
    patch_strip = 1,
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2024", versions = ["nightly/2026-08-31"])
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "vk-mem",
    repositories = ["crates"],
    gen_build_script = "off",
    link_deps = ["@@//third_party:vma"],
)
# `runfiles` is only needed for cargo builds. Bazel ships its own copy at
# @rules_rust//rust/runfiles, so redirect the crates.io target there to avoid
# pulling a duplicate.
crate.annotation(
    crate = "runfiles",
    repositories = ["crates"],
    override_target_lib = "@rules_rust//rust/runfiles",
)

crate.from_cargo(
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    name = "crates",
)
use_repo(crate, "crates")


crate.spec(package = "pumicite_cli", git = "https://github.com/dust-engine/pumicite.git", rev = "a85510b90e467c6295951fea4dce2c1d70855fb6")
crate.annotation(
    crate = "pumicite_cli",
    repositories = ["bindeps"],
    gen_all_binaries = True,
)
crate.annotation(
    crate = "shader-slang-sys",
    repositories = ["bindeps"],
    gen_build_script = "off",
    link_deps = ["@@//third_party:slang"],
)
crate.from_specs(name = "bindeps")
use_repo(crate, "bindeps")

# -----------------------------------------------------------------------------
# NVIDIA DLSS SDK: NGX headers, static libraries, and the Ray Reconstruction
# runtime libraries (see crates/pbr/src/upscaler/dlss).
# -----------------------------------------------------------------------------
new_git_repository(
    name = "dlss",
    remote = "https://github.com/NVIDIA/DLSS.git",
    commit = "a291cc7d2cc642a51566f3dfd5376f635cd1b284",
    build_file = "//third_party:dlss.BUILD.bazel",
)

# -----------------------------------------------------------------------------
# NVIDIA SHARC
# -----------------------------------------------------------------------------
new_git_repository(
    name = "sharc",
    remote = "https://github.com/NVIDIA-RTX/SHARC.git",
    commit = "5a976dc60d3a035a63a3f1959c77f1adaa1ec23c",
    build_file = "//third_party:SHARC.BUILD.bazel",
    # Apple GPUs (Metal) lack 64-bit atomics, so SHARC runs the lock-buffer
    # insert path (HASH_GRID_ENABLE_64_BIT_ATOMICS 0). This patch adds an
    # optional wait-free 32-bit-CAS claim (HASH_GRID_CLAIM_VIA_32BIT_CAS) and the
    # eviction-time flag reset it needs.
    patches = ["//third_party:sharc_lock_claim.patch"],
    patch_args = ["-p1"],
)
