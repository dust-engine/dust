module(
    name = "dust",
    version = "0.1.0",
)

# -----------------------------------------------------------------------------
# Vulkan SDK
# -----------------------------------------------------------------------------

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_vulkan", version = "0.7.0")

vulkan_sdk = use_extension("@rules_vulkan//vulkan:extensions.bzl", "vulkan_sdk")

vulkan_sdk.toolchain(version = "1.4.341.1")
use_repo(vulkan_sdk, "vulkan_sdk_1.4.341.1")

register_toolchains("@vulkan_sdk_1.4.341.1//:all")

git_override(
    module_name = "rules_vulkan",
    remote = "https://github.com/0xbeefd1ed/rules_vulkan",
    commit = "85c6ca71e2cecede88985ac89568230e772a4f34",
)

bazel_dep(name = "pumicite_super_resolution", version = "0.1.0")
git_override(
    module_name = "pumicite_super_resolution",
    remote = "https://github.com/dust-engine/pumicite_super_resolution.git",
    commit = "bd8b542e15657f49190ca33877591ef6fb5b5f31",
)

# -----------------------------------------------------------------------------
# shader-slang Rust bindings (external git repo with custom BUILD overlay)
# -----------------------------------------------------------------------------

new_git_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "new_git_repository",
)

new_git_repository(
    name = "vma",
    remote = "https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git",
    tag = "v3.3.0",
    build_file = "//third_party:vma.BUILD.bazel",
)

new_git_repository(
    name = "slang_rs",
    remote = "https://github.com/FloatyMonkey/slang-rs.git",
    commit = "4af0e9db151b9b8f52fa53390f13f3377e8e7df2",
    build_file = "//third_party:slang_rs.BUILD.bazel",
)

# -----------------------------------------------------------------------------
# Rust assetbuild dependency
# -----------------------------------------------------------------------------

bazel_dep(name = "rules_rust", version = "0.70.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2024", versions = ["nightly/2026-04-03"])
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "vk-mem",
    repositories = ["crates"],
    gen_build_script = "off",
    deps = ["@@//third_party:vma"],
)
# `runfiles` is only needed for cargo builds. Bazel ships its own copy at
# @rules_rust//rust/runfiles, so redirect the crates.io target there to avoid
# pulling a duplicate.
crate.annotation(
    crate = "runfiles",
    repositories = ["crates"],
    override_target_lib = "@rules_rust//rust/runfiles",
)
# Build pumicite_super_resolution's Rust library here (in dust's crate universe,
# so it shares dust's ash/pumicite). Attach the DLSS C shim + NGX import library
# from the @pumicite_super_resolution module and turn off the crate's standalone
# build.rs (which would otherwise compile the shim and download the SDK).
crate.annotation(
    crate = "pumicite_super_resolution",
    repositories = ["crates"],
    gen_build_script = "off",
    deps = [
        "@pumicite_super_resolution//:dlss_helpers",
        "@pumicite_super_resolution//:dlss",
    ],
)
crate.from_cargo(
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    name = "crates",
)
use_repo(crate, "crates")


crate.spec(package = "pumicite_cli", git = "https://github.com/dust-engine/pumicite.git", rev = "ee3c41179c414dc20b0085ac58627d72e71f8011")
crate.annotation(
    crate = "pumicite_cli",
    repositories = ["bindeps"],
    gen_all_binaries = True,
)
crate.annotation(
    crate = "shader-slang-sys",
    repositories = ["bindeps"],
    gen_build_script = "off",
    deps = ["@@//third_party:slang"],
)
crate.from_specs(name = "bindeps")
use_repo(crate, "bindeps")

# -----------------------------------------------------------------------------
# NVIDIA SHARC
# -----------------------------------------------------------------------------
new_git_repository(
    name = "sharc",
    remote = "https://github.com/NVIDIA-RTX/SHARC.git",
    commit = "5a976dc60d3a035a63a3f1959c77f1adaa1ec23c",
    build_file = "//third_party:SHARC.BUILD.bazel",
    # Apple GPUs (Metal) lack 64-bit atomics, so SHARC runs the lock-buffer
    # insert path (HASH_GRID_ENABLE_64_BIT_ATOMICS 0). This patch adds an
    # optional wait-free 32-bit-CAS claim (HASH_GRID_CLAIM_VIA_32BIT_CAS) and the
    # eviction-time flag reset it needs.
    patches = ["//third_party:sharc_lock_claim.patch"],
    patch_args = ["-p1"],
)
