load("@crates//:defs.bzl", "all_crate_deps", "aliases")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_static_library")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "runtime_assets",
    srcs = [
        "//assets:runtime",
        "//crates/pbr/shaders:runtime",
        "//crates/pbr/shaders/sky_atmosphere:runtime",
        "//crates/pbr/shaders/sharc:runtime",
        "//crates/vox/shaders:runtime",
        "@pumicite_super_resolution//:backend_runtime",
    ],
)

cargo_toml_env_vars(
    name = "cargo_toml_env_vars",
    src = "Cargo.toml",
)

genrule(
    name = "bazel_bin_env",
    outs = ["bazel_bin.env"],
    cmd_bash = "echo 'BAZEL_BIN=$${pwd}/$(BINDIR)' > $@",
    cmd_bat = "@echo BAZEL_BIN=%cd%/$(BINDIR)> $@",
)

rust_library(
    name = "dust_lib",
    crate_name = "dust",
    crate_root = "src/lib.rs",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/entry.rs",
        ],
    ),
    compile_data = ["Cargo.toml"],
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//crates/vox:dust_vox",
        "//crates/pbr:dust_pbr",
        "//crates/app:dust_app",
        "//crates/gfxdebug:dust_gfxdebug",
    ] + select({
        # macOS has no system Vulkan loader; link the SDK's so ash's runtime
        # dlopen("libvulkan.dylib") resolves to the bundled, rpath-staged loader.
        "@platforms//os:macos": ["@vulkan_sdk//:vulkan"],
        "//conditions:default": [],
    }),
    rustc_env_files = [":cargo_toml_env_vars"],
    aliases = aliases(),
)

rust_binary(
    name = "dust",
    crate_name = "dust",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs"],
    edition = "2024",
    deps = [":dust_lib"],
    data = [":runtime_assets"],
)

rust_static_library(
    name = "dust_entry",
    crate_name = "dust_entry",
    crate_root = "src/entry.rs",
    srcs = ["src/entry.rs"],
    edition = "2024",
    deps = [":dust_lib"],
    data = [":runtime_assets"],
    aspect_hints = ["@build_bazel_rules_apple//apple:use_runfiles"],
)
